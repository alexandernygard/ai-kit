{
  "name": "@alexandernygard/ai-kit",
  "version": "0.1.0",
  "description": "Isomorphic TypeScript runtime for AI agents: sessions, forks, tools, approvals, subagents, skills, code mode, progressive tool disclosure and plugins.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/alexandernygard/ai-kit.git", "directory": "packages/core" },
  "homepage": "https://github.com/alexandernygard/ai-kit/tree/main/packages/core#readme",
  "bugs": "https://github.com/alexandernygard/ai-kit/issues",
  "author": "Alexander Nyg\u00e5rd",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "ai-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "ai-kit-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "claude",
    "openai",
    "tools",
    "sessions"
  ]
}
