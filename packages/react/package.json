{
  "name": "@alexandernygard/ai-kit-react",
  "version": "0.1.0",
  "description": "React hooks for ai-kit: useChat, useSessions, useAgents and headless message rendering. Pair with @alexandernygard/components for the visuals.",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Nygård",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "ai-kit-source": "./src/index.tsx", "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@alexandernygard/ai-kit-client": "workspace:^"
  },
  "peerDependencies": {
    "@alexandernygard/ai-kit": "workspace:^",
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@alexandernygard/ai-kit": "workspace:^",
    "@alexandernygard/ai-kit-server": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "happy-dom": "^20.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
