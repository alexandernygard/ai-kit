{
  "name": "@alexandernygard/ai-kit-claude-agent",
  "version": "0.1.0",
  "description": "ai-kit harness driver for the Claude Agent SDK. Runs agents on Claude Code, with your Claude subscription or an API key.",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Nygård",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "ai-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@alexandernygard/ai-kit-mcp": "workspace:^"
  },
  "peerDependencies": {
    "@alexandernygard/ai-kit": "workspace:^",
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "devDependencies": {
    "@alexandernygard/ai-kit": "workspace:^",
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5"
  }
}
