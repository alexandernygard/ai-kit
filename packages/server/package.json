{
  "name": "@alexandernygard/ai-kit-server",
  "version": "0.1.1",
  "description": "HTTP API for ai-kit on Web-standard Request/Response: Hono, Next.js, SvelteKit, Cloudflare Workers, Bun, Deno, Node.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/alexandernygard/ai-kit.git", "directory": "packages/server" },
  "homepage": "https://github.com/alexandernygard/ai-kit/tree/main/packages/server#readme",
  "bugs": "https://github.com/alexandernygard/ai-kit/issues",
  "author": "Alexander Nygård",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "ai-kit-source": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@alexandernygard/ai-kit": "workspace:^"
  },
  "devDependencies": {
    "@alexandernygard/ai-kit": "workspace:^"
  }
}
