{
  "name": "@alexandernygard/ai-kit-client",
  "version": "0.1.0",
  "description": "Browser client for ai-kit: typed API, streaming, reconnects, and a framework-agnostic chat controller (works as a Svelte store).",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Nygård",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "ai-kit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@alexandernygard/ai-kit": "workspace:^"
  },
  "devDependencies": {
    "@alexandernygard/ai-kit": "workspace:^",
    "@alexandernygard/ai-kit-server": "workspace:^",
    "fake-indexeddb": "^6.2.6"
  }
}
