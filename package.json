{
  "name": "ai-kit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm typecheck && pnpm test && pnpm build && changeset publish",
    "test:live": "AI_KIT_LIVE=1 vitest run packages/anthropic/test/live.test.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
